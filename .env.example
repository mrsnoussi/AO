# Copier ce fichier en .env pour un usage local (charge automatiquement par
# python-dotenv). En CI, ces valeurs viennent des secrets/variables GitHub Actions.

# Travelpayouts (obligatoire) - https://www.travelpayouts.com/developers/api
TRAVELPAYOUTS_TOKEN=

# SerpAPI (optionnel, desactive par defaut) - https://serpapi.com/
SERPAPI_ENABLED=false
SERPAPI_API_KEY=

# SMTP pour l'envoi des mails d'alerte et de recap
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TO=
